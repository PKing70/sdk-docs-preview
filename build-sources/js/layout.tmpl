<?js
/*
  Splunk SDK reference — JSDoc layout override.

  Wired up via jsdoc.json:
      "templates": { "default": {
          "layoutFile": "theme/layout.tmpl",
          "staticFiles": { "include": ["theme/splunk-jsdoc.css"] }
      }}

  Differences from JSDoc's stock layout.tmpl:
    1. splunk-jsdoc.css is linked LAST so its rules win on equal specificity.
    2. The Splunk masthead is injected above #main — identical markup and class
       names to the Sphinx (page.html) and JavaDoc (-top) overlays, so all three
       kits share one chrome definition.
    3. <title> drops the "JSDoc:" prefix in favour of the product name.
    4. The IE9 html5shiv and its remote script reference are removed.

  Version list is read from `env.conf.splunk` so it stays out of the markup:
      "splunk": {
        "product": "Splunk SDK for JavaScript",
        "docsBase": "https://splunk.github.io/splunk-sdk-javascript",
        "currentVersion": "latest",
        "versions": [["latest","2.0.2 (latest)"], ["1.12.0","1.12.0"]],
        "portalUrl": "https://dev.splunk.com/enterprise/docs/devtools/javascript/sdk-javascript/"
      }

  NOTE: this bakes the version list in at build time, which goes stale for
  historical builds. The agreed production design replaces it with a runtime
  fetch of versions.json injected post-build — see DOX-TO-JSDOC-FINDINGS.md.
*/
var splunk = (env.conf && env.conf.splunk) || {};
var product = splunk.product || 'Splunk SDK';
var docsBase = splunk.docsBase || '';
var currentVersion = splunk.currentVersion || '';
var versions = splunk.versions || [];
var portalUrl = splunk.portalUrl || 'https://dev.splunk.com/';
?><!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><?js= title ?> &middot; <?js= product ?></title>

    <script src="scripts/prettify/prettify.js"> </script>
    <script src="scripts/prettify/lang-css.js"> </script>
    <link type="text/css" rel="stylesheet" href="styles/prettify-tomorrow.css">
    <link type="text/css" rel="stylesheet" href="styles/jsdoc-default.css">
    <!-- Splunk overlay loads last so it wins on equal specificity -->
    <link type="text/css" rel="stylesheet" href="splunk-jsdoc.css">
</head>

<body>

<div class="splunk-masthead">
  <div class="splunk-masthead__accent" aria-hidden="true"></div>
  <nav class="splunk-masthead__inner" aria-label="Splunk developer documentation">
    <!-- TODO swap for the licensed Splunk logo asset; text wordmark is a placeholder -->
    <a class="splunk-masthead__wordmark" href="https://dev.splunk.com/">splunk&gt;</a>
    <span class="splunk-masthead__divider" aria-hidden="true"></span>
    <a class="splunk-masthead__product" href="index.html"><?js= product ?></a>

    <span class="splunk-masthead__spacer"></span>

    <div class="splunk-masthead__right">
      <?js if (versions && versions.length) { ?>
      <div class="splunk-version">
        <label class="splunk-version__label" for="splunk-version-select">Version</label>
        <select class="splunk-version__select" id="splunk-version-select"
                onchange="if(this.value)window.location.href=this.value;">
          <?js versions.forEach(function (v) { ?>
          <option value="<?js= docsBase ?>/<?js= v[0] ?>/"<?js= v[0] === currentVersion ? ' selected' : '' ?>><?js= v[1] ?></option>
          <?js }); ?>
        </select>
      </div>
      <?js } ?>
      <a class="splunk-masthead__portal-link" href="<?js= portalUrl ?>">Guides on dev.splunk.com</a>
    </div>
  </nav>
</div>

<?js if (currentVersion && currentVersion !== 'latest') { ?>
<div class="splunk-version-banner">
  You are viewing documentation for version <strong><?js= currentVersion ?></strong>.
  <a href="<?js= docsBase ?>/latest/">Go to the latest version</a>.
</div>
<?js } ?>

<nav>
    <?js= this.nav ?>
</nav>

<div id="main">

    <h1 class="page-title"><?js= title ?></h1>

    <?js= content ?>
</div>

<br class="clear">

<footer>
    <?js= product ?> API reference. Documentation generated by
    <a href="https://github.com/jsdoc/jsdoc">JSDoc <?js= env.version.number ?></a>.
</footer>

<script> prettyPrint(); </script>
<script src="scripts/linenumber.js"> </script>
</body>
</html>
